#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
gpxart - 在指定边界多边形内生成「图形」运动轨迹 GPX

和 runroute 的分工：
  gpxart  负责「画什么形状、摆在哪里、会不会越界」；
  runroute 负责「走多快、时间戳、GPS 漂移」，并直接调用它补时间。

核心保证：**每个顶点都在边界内缩 margin 米之后的区域里**，逐点校验并报最小余量。

用法:
  gpxart list
  gpxart make --shape heart --boundary boundary.geojson --size 560 --pace 6:00 -o heart.gpx
  gpxart make --shape nju --boundary boundary.geojson --preview nju.png -o nju.gpx
  gpxart check --boundary boundary.geojson --gpx heart.gpx
"""
import argparse
import json
import math
import os
import subprocess
import sys
import tempfile

M_PER_DEG = 111320.0
def _fn_find_runroute():
    """优先用与本脚本同目录的 runroute（仓库自包含），再退回 ~/.local/bin。"""
    here = os.path.dirname(os.path.abspath(__file__))
    for p in (os.path.join(here, "runroute"),
              os.path.expanduser("~/.local/bin/runroute")):
        if os.path.isfile(p):
            return p
    return os.path.expanduser("~/.local/bin/runroute")


RUNROUTE = _fn_find_runroute()

# runroute 是无扩展名的 Python 脚本：Windows 上不能直接执行（WinError 193），
# 统一用当前解释器起，POSIX 下也一并统一，少一条平台分支。
PY_EXE = sys.executable or ("python" if os.name == "nt" else "python3")


def m_per_deg_lon(lat):
    return M_PER_DEG * math.cos(math.radians(lat))


def read_boundary(path):
    """读 GeoJSON / 纯坐标数组，返回外环 [(lon,lat), ...]。"""
    raw = json.load(open(path, encoding="utf-8"))
    if isinstance(raw, dict) and raw.get("type") == "FeatureCollection":
        geom = raw["features"][0]["geometry"]
    elif isinstance(raw, dict) and raw.get("type") == "Feature":
        geom = raw["geometry"]
    elif isinstance(raw, dict) and raw.get("type") == "Polygon":
        geom = raw
    elif isinstance(raw, list):
        return raw
    else:
        raise SystemExit("看不懂的边界文件: %s" % path)
    if geom["type"] == "Polygon":
        rings = [geom["coordinates"][0]]
    elif geom["type"] == "MultiPolygon":
        rings = [p[0] for p in geom["coordinates"]]
    else:
        raise SystemExit("边界需为 Polygon/MultiPolygon，实际是 %s" % geom["type"])
    return max(rings, key=lambda r: len(r))


class Frame:
    """等距圆柱近似：把经纬度和局部平面米坐标互相换算。"""

    def __init__(self, ring):
        self.lon0 = sum(p[0] for p in ring) / len(ring)
        self.lat0 = sum(p[1] for p in ring) / len(ring)
        self.k = m_per_deg_lon(self.lat0)

    def fwd(self, lon, lat):
        return ((lon - self.lon0) * self.k, (lat - self.lat0) * M_PER_DEG)

    def inv(self, x, y):
        return (self.lon0 + x / self.k, self.lat0 + y / M_PER_DEG)


def shoelace(pts):
    a = 0.0
    for i in range(len(pts)):
        x1, y1 = pts[i]
        x2, y2 = pts[(i + 1) % len(pts)]
        a += x1 * y2 - x2 * y1
    return a / 2.0


def dist_to_poly(pt, poly):
    """点到多边形边界的距离（正=在内，负=在外）。"""
    x, y = pt
    inside = False
    n = len(poly)
    best = float("inf")
    for i in range(n):
        x1, y1 = poly[i]
        x2, y2 = poly[(i + 1) % n]
        if (y1 > y) != (y2 > y):
            xin = (x2 - x1) * (y - y1) / (y2 - y1) + x1
            if x < xin:
                inside = not inside
        dx, dy = x2 - x1, y2 - y1
        L2 = dx * dx + dy * dy
        t = 0.0 if L2 == 0 else max(0.0, min(1.0, ((x - x1) * dx + (y - y1) * dy) / L2))
        d = math.hypot(x - (x1 + t * dx), y - (y1 + t * dy))
        if d < best:
            best = d
    return best if inside else -best


# ---------------------------------------------------------------- 图形库
# 每个图形返回「单位坐标」点列，后续统一归一化 + 缩放。

def _heart_loop(n=720):
    """经典心形参数曲线，n 个点，首尾不重复。起点/终点都是顶端的心口（凹点）。"""
    return [(16 * math.sin(t) ** 3,
             13 * math.cos(t) - 5 * math.cos(2 * t)
             - 2 * math.cos(3 * t) - math.cos(4 * t))
            for t in (2 * math.pi * i / n for i in range(n))]


def _close(seq):
    return seq + [seq[0]]


def _from_lowest(loop, reverse=False):
    """从最低点（底尖）起笔走一圈再回底尖。横排时用它，让相邻爱心靠底尖连线。"""
    k = min(range(len(loop)), key=lambda i: loop[i][1])
    seq = loop[k:] + loop[:k]
    if reverse:
        seq = [seq[0]] + seq[:0:-1]
    return _close(seq)


def shape_heart(n=720):
    return _close(_heart_loop(n))


def shape_hearts_row(n=3, gap=0.30, per=360):
    """n 个爱心横排，底尖对齐 —— 底尖之间自然连成一条「串珠」短线。

    每个爱心从自己的底尖起笔、回底尖收笔，所以圈间连线只在 y=底尖 处，
    不会横穿邻心的轮廓。
    """
    step = 32.0 * (1 + gap)
    x0 = -(n - 1) * step / 2.0
    pts = []
    for i in range(n):
        seq = _from_lowest(_heart_loop(per), reverse=(i % 2 == 1))
        pts += [(x + x0 + i * step, y) for (x, y) in seq]
    return pts


def shape_hearts_nested(count=3, ratio=0.62, per=420):
    """同心爱心：外圈最大，里面再套 count-1 个，等比缩小。

    全部从各自的心口（顶端凹点）起笔，所以圈间接线是心口之间的一小段竖线，
    落在爱心的凹口里，不压轮廓。bbox 中心对齐（心形重心偏上，直接按中心套会歪）。
    """
    if count < 2:
        raise ValueError("同心爱心至少 2 个")
    out = _close(_heart_loop(per))
    oy = (max(p[1] for p in out) + min(p[1] for p in out)) / 2.0
    for k in range(1, count):
        s = ratio ** k
        loop = _close(_heart_loop(per))
        iy = (max(p[1] for p in loop) + min(p[1] for p in loop)) / 2.0 * s
        shift = oy - iy
        out += [(x * s, y * s + shift) for (x, y) in loop]
    return out


def shape_heartnest():
    return shape_hearts_nested(count=2, ratio=0.50)


def shape_star(n_per_edge=48):
    """五角星：按 0→2→4→1→3→0 连笔（一笔画成的尖角星）。"""
    verts = [(math.sin(math.radians(-90 + 72 * k)), math.cos(math.radians(-90 + 72 * k)))
             for k in range(5)]
    order = [0, 2, 4, 1, 3, 0]
    pts = []
    for i in range(len(order) - 1):
        a, b = verts[order[i]], verts[order[i + 1]]
        for j in range(n_per_edge):
            f = j / n_per_edge
            pts.append((a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f))
    pts.append(verts[order[-1]])
    return pts


def shape_infinity(n=900):
    """∞：伯努利双纽线，自交于原点。"""
    pts = []
    for i in range(n + 1):
        t = 2 * math.pi * i / n
        d = 1 + math.sin(t) ** 2
        pts.append((math.cos(t) / d, math.sin(t) * math.cos(t) / d))
    return pts


def shape_spiral(turns=3.0, n=1400):
    """阿基米德螺旋：从中心均匀向外张开。
    注意别用「方形螺旋」——腿长 1,1,2,2,3,3… 时相邻腿近乎抵消，包围盒只有 ~20 单位
    而笔画总长 ~420 单位，一缩放就变成十几公里，完全跑不动。"""
    pts = []
    for i in range(n + 1):
        t = 2 * math.pi * turns * i / n
        r = t / (2 * math.pi * turns)
        pts.append((r * math.cos(t), r * math.sin(t)))
    return pts


def _glyph(one):
    return one


def _arc(cx, cy, rx, ry, a0, a1, n=24, ccw=False):
    pts = []
    for i in range(n + 1):
        a = math.radians(a0 + (a1 - a0) * i / n)
        # 屏幕坐标 y 向下，这里 y 向上，故取负
        pts.append((cx + rx * math.cos(a), cy + ry * math.sin(a)))
    return pts


def _letters(text, gap=0.28, height=1.0):
    """笔画字库：每个字形是一串连续点（0..1 盒内，y 向上）。"""
    def N():
        return [(0, 0), (0, 1), (1, 0), (1, 1)]
    def J():
        stem = [(0.75, 1), (0.75, 0.3)]
        hook = _arc(0.45, 0.3, 0.3, 0.3, 0, 180, 24)[::-1]
        hook = [(0.45 + 0.3 * math.cos(math.radians(a)), 0.3 - 0.3 * math.sin(math.radians(a)))
                for a in range(0, 181, 8)]
        tail = [(0.15, 0.3), (0.14, 0.52)]
        return stem + hook[:-1] + tail
    def U():
        left = [(0, 1), (0, 0.4)]
        bowl = [(0.5 + 0.5 * math.cos(math.radians(a)), 0.4 - 0.4 * math.sin(math.radians(a)))
                for a in range(180, -1, -8)]
        right = [(1, 0.4), (1, 1)]
        return left + bowl + right
    def V5():
        return [(0.85, 1), (0.2, 1), (0.2, 0.6), (0.6, 0.6), (0.85, 0.45),
                (0.85, 0.15), (0.6, 0.0), (0.18, 0.0)]
    def V2():
        top = [(0.15, 0.8), (0.3, 0.97), (0.6, 1.0), (0.82, 0.86), (0.84, 0.66),
               (0.62, 0.48), (0.15, 0.0), (0.9, 0.0)]
        return top
    def V0():
        return [(0.5 + 0.34 * math.cos(math.radians(a)), 0.5 + 0.5 * math.sin(math.radians(a)))
                for a in range(90, -271, -8)]
    table = {"N": N, "J": J, "U": U, "5": V5, "2": V2, "0": V0}
    pts = []
    for i, ch in enumerate(text):
        g = table[ch]()
        for (x, y) in g:
            pts.append((x + i * (1 + gap), y * height))
    return pts


def shape_nju():
    return _letters("NJU")


def shape_520():
    return _letters("520", gap=0.34)


